# ==============================================================================
# AI Automation Labs Connect — Environment Configuration Template
# Organisation: AI Automation Labs LLP
# ==============================================================================

# Core runtime environment (development, staging, production)
NODE_ENV=development
PORT=3000

# Public URLs used for OAuth redirects, invitations, and webhooks
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000/api/v1

# Primary PostgreSQL Database connection string
DATABASE_URL=postgresql://postgres@localhost:5432/rocketship

# Redis connection string for cache, pub/sub, and queue workers (optional in dev)
REDIS_URL=redis://localhost:6379

# Session and JWT signing secret (minimum 32 characters in production)
SESSION_SECRET=dev-ailabs-secret-key-change-in-production-min-32-chars
SESSION_COOKIE_NAME=ailabs_session

# Trusted CORS origins allowlist (comma-separated)
TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap owner credentials (used by `npm run bootstrap:owner`)
BOOTSTRAP_OWNER_EMAIL=owner@aiautomationlabs.com
BOOTSTRAP_OWNER_NAME=Owner Admin
BOOTSTRAP_OWNER_SECRET=Admin123!SecurePassword

# Outbound SMTP Mail Configuration (Optional for MVP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@aiautomationlabs.com

# File storage driver (local, s3, minio)
FILE_STORAGE_DRIVER=local
FILE_STORAGE_BUCKET=uploads
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

# External Channel Integrations (Optional, activated when credentials provided)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
META_APP_ID=
META_APP_SECRET=
SMS_PROVIDER=
SMS_API_KEY=

# AI Assistant Integration (local, openai, anthropic)
AI_PROVIDER=local
AI_API_KEY=

# Audio / Video WebRTC Meetings (LiveKit)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
